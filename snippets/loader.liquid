<div class="loader" role="status" aria-label="Carregando">
  <div class="loader-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
</div>
<script>
  /* First visit to the homepage in this browser session only */
  (function () {
    var loader = document.querySelector('.loader');
    var seen = false;
    try { seen = sessionStorage.getItem('im-loader-seen') === '1'; } catch (e) {}
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduce || window.Shopify && Shopify.designMode) { loader.remove(); return; }
    try { sessionStorage.setItem('im-loader-seen', '1'); } catch (e) {}
    document.documentElement.classList.add('is-loading');
    var started = Date.now();
    var SEQUENCE = 5 * 300 + 200 + 500 + 150;
    function finish() {
      setTimeout(function () {
        loader.classList.add('is-done');
        document.documentElement.classList.remove('is-loading');
        setTimeout(function () { loader.remove(); }, 500);
      }, Math.max(0, SEQUENCE - (Date.now() - started)));
    }
    if (document.readyState === 'complete') finish(); else window.addEventListener('load', finish);
  })();
</script>
