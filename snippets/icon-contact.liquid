{%- comment -%} Usage: {% render 'icon-contact', icon: 'phone' | 'email' | 'instagram' %} {%- endcomment -%}
<svg class="icon-contact" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'phone' -%}
      <rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/>
      <path d="M10.5 18.5h3"/>
    {%- when 'email' -%}
      <rect x="2.5" y="5" width="19" height="14" rx="1.8"/>
      <path d="m3.2 6 8.8 7 8.8-7"/>
    {%- when 'instagram' -%}
      <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.2"/>
      <circle cx="12" cy="12" r="4.3"/>
      <circle cx="17.4" cy="6.6" r=".6" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
